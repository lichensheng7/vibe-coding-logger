{
 "openapi": "3.1.0",
 "info": {
  "title": "Vibe Coding Logger API",
  "version": "0.1.0",
  "description": "记录与 AI 的 vibe coding 聊天。项目(project)隔离，消息(message)按 seq 连续排序；每条 user 消息开启新的一轮(turn)，其后的 assistant/tool/system/note 都属于这一轮。\n\n鉴权：`Authorization: Bearer <API_TOKEN>`（也可用 `X-API-Token` 头或 `?token=`）。\n\n时间字段均为毫秒时间戳；写入时 sent_at 也接受秒级时间戳或 ISO 字符串。"
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "security": [
  {
   "bearer": []
  }
 ],
 "tags": [
  {
   "name": "projects"
  },
  {
   "name": "messages"
  },
  {
   "name": "import-export"
  },
  {
   "name": "misc"
  }
 ],
 "paths": {
  "/api/health": {
   "get": {
    "summary": "健康检查",
    "tags": [
     "misc"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Envelope"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "security": []
   }
  },
  "/api/projects": {
   "get": {
    "summary": "项目列表",
    "tags": [
     "projects"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ProjectList"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "名称/描述模糊搜索"
     },
     {
      "name": "tag",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "archived",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "all",
        "only"
       ]
      },
      "description": "默认不含归档"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      }
     }
    ]
   },
   "post": {
    "summary": "创建项目（可同时带 messages 一次写入）",
    "tags": [
     "projects"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ProjectResp"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "allOf": [
         {
          "$ref": "#/components/schemas/ProjectInput"
         },
         {
          "type": "object",
          "properties": {
           "messages": {
            "type": "array",
            "items": {
             "$ref": "#/components/schemas/MessageInput"
            }
           },
           "on_duplicate": {
            "type": "string",
            "enum": [
             "skip",
             "update",
             "error"
            ]
           }
          }
         }
        ]
       }
      }
     }
    }
   }
  },
  "/api/projects/{id}": {
   "get": {
    "summary": "项目详情（含统计）",
    "tags": [
     "projects"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ProjectResp"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "项目 id 或 slug"
     }
    ]
   },
   "patch": {
    "summary": "修改项目",
    "tags": [
     "projects"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ProjectResp"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "项目 id 或 slug"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ProjectInput"
       }
      }
     }
    }
   },
   "delete": {
    "summary": "删除项目及其全部消息",
    "tags": [
     "projects"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Envelope"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "项目 id 或 slug"
     }
    ]
   }
  },
  "/api/projects/{id}/messages": {
   "get": {
    "summary": "消息列表（按 seq 升序，含 turn）",
    "tags": [
     "messages"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/MessageList"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "项目 id 或 slug"
     },
     {
      "name": "role",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "author",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "内容搜索"
     },
     {
      "name": "turn",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "from_seq",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "默认 500，最大 5000"
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      }
     }
    ]
   },
   "post": {
    "summary": "追加/插入消息：单条对象、{messages:[...]} 或裸数组",
    "tags": [
     "messages"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Envelope"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "description": "单条返回 {data: Message, status: created|skipped|updated}，HTTP 201/200；批量返回 {data:{created,updated,skipped,items:[{id,seq,status,ext_id}]}}。带 ext_id 可安全重试。",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "项目 id 或 slug"
     },
     {
      "name": "position",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "插入到第 N 条之前"
     },
     {
      "name": "after_id",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "before_id",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "on_duplicate",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "skip",
        "update",
        "error"
       ]
      },
      "description": "ext_id 已存在时的处理，默认 skip"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "oneOf": [
         {
          "$ref": "#/components/schemas/MessageInput"
         },
         {
          "type": "array",
          "items": {
           "$ref": "#/components/schemas/MessageInput"
          }
         },
         {
          "type": "object",
          "properties": {
           "messages": {
            "type": "array",
            "items": {
             "$ref": "#/components/schemas/MessageInput"
            }
           },
           "position": {
            "type": "integer"
           },
           "after_id": {
            "type": "string"
           },
           "before_id": {
            "type": "string"
           },
           "on_duplicate": {
            "type": "string"
           }
          }
         }
        ]
       }
      }
     }
    }
   },
   "put": {
    "summary": "用新数组整体替换项目全部消息",
    "tags": [
     "messages"
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Envelope"
        }
       }
      }
     },
     "4XX": {
      "description": "错误",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "项目 id 或 slug"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "messages": {
          "type": "array",
          "items": {
           "$ref": "#/components/schemas/MessageInput"
          }
         }
        }
       }
      }
     }
    }
   }
  },
