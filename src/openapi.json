    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "ids": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "filter": {
          "type": "object",
          "properties": {
           "role": {
            "type": "string"
           },
           "author": {
            "type": [
             "string",
             "null"
            ]
           }
          }
         },
         "all": {
          "type": "boolean"
         },
         "set": {
          "type": "object",
          "properties": {
           "role": {
            "type": "string"
           },
           "author": {
            "type": [
             "string",
             "null"
            ]
           },
           "format": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
